# Orbit (Meraj OS) Environment Configuration Example

# Database Connection
MONGODB_URI=mongodb://localhost:27017/meraj_os

# Google OAuth Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth / App Secret
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXTAUTH_URL=http://localhost:3000

# Nodemailer / Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
NOTIFICATION_EMAIL=your_notification_email@gmail.com
ADMIN_EMAIL=your_admin_email@gmail.com

# Token Encryption Secret (32-byte secret for AES-256-GCM)
ENCRYPTION_SECRET=your_32_byte_secret_encryption_key_here

# Active AI Provider Selector: 'gemini' | 'openai' | 'anthropic' | 'groq' | 'ollama' | 'mock'
AI_PROVIDER=gemini

# AI Provider API Keys & Credentials
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Offline Benchmark Mode (Shortcut to force mock provider)
AGENT_MOCK_MODE=false

